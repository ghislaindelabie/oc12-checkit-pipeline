# Copy to .env and fill in. Never commit .env.
# All bulk data (raw, processed, images, corpora) lands under this root:
CHECKIT_DATA_ROOT=/data/files/OC12

CHECKIT_DATABASE_URL=postgresql://checkit:change-me@localhost:5432/checkit

# API keys — leave empty to skip a source (the pipeline degrades gracefully).
# Registration checklist: docs/api-keys.md
CHECKIT_NEWSDATA_API_KEY=
CHECKIT_GUARDIAN_API_KEY=
CHECKIT_GNEWS_API_KEY=
CHECKIT_CURRENTS_API_KEY=
CHECKIT_MEDIASTACK_API_KEY=
CHECKIT_THENEWSAPI_API_KEY=
CHECKIT_WORLDNEWS_API_KEY=
CHECKIT_PSEUDO_SALT=change-me-unique-salt

# Database (docker compose -f docker-compose.db.yml up -d)
CHECKIT_PG_ADMIN_PASSWORD=
CHECKIT_ETL_PASSWORD=
CHECKIT_DASHBOARD_PASSWORD=
CHECKIT_ENC_KEY=
CHECKIT_DATABASE_URL=postgresql://etl_writer:<CHECKIT_ETL_PASSWORD>@localhost:5433/checkit
